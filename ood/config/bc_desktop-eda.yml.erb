---
title: "EDA Desktop"
cluster: "tricluster"
submit: "submit/ood.yml.erb"

<%
  require "open3"
  node_ids = %w[150 151 152 153 154 155]
  node_rows = node_ids.map do |n|
    ip = "172.16.50.#{n}"
    total_gb = used_gb = free_gb = jobs = 0
    total_cpus = alloc_cpus = free_cpus = 0
    state = "?"
    begin
      out, = Open3.capture2("/usr/bin/scontrol", "show", "node", "-o", ip)
      vals = out.scan(/([A-Za-z0-9_]+)=([^\s]+)/).to_h
      total_mb = vals["RealMemory"].to_i
      used_mb = vals["AllocMem"].to_i
      total_gb = total_mb / 1024
      used_gb = used_mb / 1024
      free_gb = [(total_mb - used_mb) / 1024, 0].max
      state = vals["State"].to_s.split("+").first
      total_cpus = vals["CPUTot"].to_i
      alloc_cpus = vals["CPUAlloc"].to_i
      free_cpus = [total_cpus - alloc_cpus, 0].max
      jout, = Open3.capture2("/usr/bin/squeue", "-h", "-w", ip, "-t", "RUNNING", "-o", "%i")
      jobs = jout.lines.count { |line| !line.strip.empty? }
    rescue StandardError
    end
    [n, total_gb, used_gb, free_gb, jobs, state, free_cpus, alloc_cpus, total_cpus]
  end
%>
<%
  preferred_rows = node_rows.reject { |row| row[0] == "150" }
  default_node = (preferred_rows.max_by { |row| row[6] } || node_rows.max_by { |row| row[6] }).first rescue "151"
%>

attributes:
  desktop: "gnome"
  bc_vnc_idle: 0
  bc_vnc_resolution:
    required: true
  bc_num_hours:
    label: "Number of hours"
    value: 1
    min: 1
    max: 128
  bc_cpus:
    label: "CPU cores"
    help: "桌面作业每个节点的 CPU 核数，按实际需要填写。"
    value: 4
    min: 1
    max: 112
    step: 1
    widget: number_field
    required: true
  bc_node:
    label: "Node"
    help: "选择桌面运行的单个节点；括号内依次为 CPU 可用/已用/总、内存可用/已用/总、运行作业数；默认选择空闲 CPU 最多的节点。"
    widget: select
    value: "<%= default_node %>"
    options:
<% node_rows.each do |n, total, used, free, jobs, state, free_cpus, alloc_cpus, total_cpus| %>
      - ["<%= n %> | CPU <%= free_cpus %>/<%= alloc_cpus %>/<%= total_cpus %> | 内存 <%= free %>/<%= used %>/<%= total %>G | 作业 <%= jobs %> | <%= state %>", "<%= n %>"]
<% end %>
  bc_mem:
    label: "Memory (GB)"
    help: "节点内存大小，单位 GB。默认 32G。"
    value: 32
    min: 1
    max: 1900
    step: 1
    widget: number_field
    required: true

form:
  - desktop
  - bc_num_hours
  - bc_cpus
  - bc_node
  - bc_mem
  - bc_vnc_resolution
