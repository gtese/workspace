+# ---------------------------------------------------------------------------
+# 跨平台兼容层
+#   macOS/BSD 自带 grep 不支持 -P，而脚本大量用 grep -woP 提取字段。
+#   优先用 GNU grep；没有时用 perl 实现同样的提取逻辑，保证脚本可运行。
+# ---------------------------------------------------------------------------
+
+# 毫秒时间戳：GNU date 的 %N/%3N 在 BSD date 上不生效，这里逐级降级
+now_ms() {
+    local ts=''
+    ts=$(date +%s%3N 2>/dev/null)
+    case "$ts" in
+    '' | *[!0-9]*) ts='' ;;
+    esac
+    if [ -z "$ts" ] && command_exists perl; then
+        ts=$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null)
+    fi
+    if [ -z "$ts" ]; then
+        ts=$(( $(date +%s) * 1000 ))
+    fi
+    echo "$ts"
+}
+
+# 统一输出 MD5 摘要（只输出 32 位十六进制，不带文件名/分隔符）
+md5_hex() {
+    case "$MD5_IMPL" in
+    md5sum) command md5sum | awk '{print $1; exit}' ;;
+    md5) command md5 -q ;;
+    openssl) command openssl dgst -md5 -r | awk '{print $1; exit}' ;;
+    *) return 1 ;;
+    esac
+}
+
+init_tool_compat() {
