+}
+
+# 统一入口：GNU grep 模式直接透传；perl 模式只拦截脚本实际用到的 3 种写法
+grep() {
+    if [ "$GREP_P_MODE" = 'perl' ]; then
+        case "$1" in
+        -woP) shift; grep_perl -w "$@" ;;
+        -oP) shift; grep_perl -o "$@" ;;
+        -P) shift; grep_perl -P "$@" ;;
+        *) command grep "$@" ;;
+        esac
+    else
+        command grep "$@"
+    fi
+}
+
+# 用 perl 模拟 grep -P / -oP / -woP（stdin + 单个模式，脚本内部只这样用）
+grep_perl() {
+    local mode="$1"
+    shift
+    local pat="$1"
+
+    if [ "$mode" = '-P' ]; then
+        GREP_PAT="$pat" perl -ne '
+            BEGIN { $p = $ENV{GREP_PAT}; $re = qr#$p#; }
+            print if /$re/;
+        '
+        return $?
+    fi
+
+    GREP_PAT="$pat" GREP_WORD="$mode" perl -ne '
+        BEGIN {
+            $p = $ENV{GREP_PAT};
+            if ($ENV{GREP_WORD} eq q{-w}) {
+                # GNU grep -P -w 实际就是把模式包成 (?<!\w)(?:PAT)(?!\w)
+                $re = qr/(?<![A-Za-z0-9_])(?:$p)(?![A-Za-z0-9_])/;
+            } else {
+                $re = qr/$p/;
+            }
+        }
+        while (/$re/g) {
+            next if $& eq q{};
+            print "$&\n";
+        }
+    '
+}
