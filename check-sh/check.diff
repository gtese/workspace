+        exit 1
+    fi
+
+    if command_exists md5sum; then
+        MD5_IMPL='md5sum'
+    elif command_exists md5; then
+        MD5_IMPL='md5'
+    elif command_exists openssl; then
+        MD5_IMPL='openssl'
+    else
+        MD5_IMPL=''
+    fi
