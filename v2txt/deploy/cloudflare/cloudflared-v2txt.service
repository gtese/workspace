[Unit]
Description=Cloudflare Tunnel for V2TXT
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# token 放在 700 目录、600 文件里，用 EnvironmentFile 注入
EnvironmentFile=/home/user/.mm/cloudflared-v2txt
# TUNNEL_TOKEN=... 由 cloudflared 读取的环境变量名为 TUNNEL_TOKEN
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
User=user
Group=user
# 只允许出站
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/.cloudflared

[Install]
WantedBy=multi-user.target
