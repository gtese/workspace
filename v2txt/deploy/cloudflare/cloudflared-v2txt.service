[Unit]
Description=Cloudflare Tunnel for V2TXT
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# token 放在 700 目录、600 文件里，用 EnvironmentFile 注入（文件内含 TUNNEL_TOKEN=...）
EnvironmentFile=/home/user/.mm/cloudflared-v2txt
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token ${TUNNEL_TOKEN}
Restart=always
RestartSec=5
User=user
Group=user
# 只允许出站
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/.cloudflared

[Install]
WantedBy=multi-user.target
