# ===== V2TXT 运行配置（复制为 .env 后修改，权限 0600）=====

# 基础
FM_APP_ENV=prod
FM_SITE_NAME=V2TXT
FM_PUBLIC_BASE_URL=https://app.v2txt.cn
FM_SECRET_KEY=__CHANGE_ME_64_HEX__
FM_DATA_DIR=/app/data
FM_LOG_LEVEL=INFO

# 账号
FM_SESSION_TTL_DAYS=30
FM_SIGNUP_BONUS_MINUTES=60
FM_ALLOW_SELF_REGISTER=true
FM_ADMIN_EMAILS=you@example.com      # 逗号分隔，逗号后不要空格
FM_LOW_BALANCE_WARN_MINUTES=10

# 计费
FM_BILLING_CURRENCY=USD
FM_PRICE_PER_MINUTE_USD=0.02
FM_MIN_BILLED_MINUTES=0.5
FM_BILLING_ROUND_MINUTES=0.1

# 收款信息（对公转账，展示给客户）
FM_PAY_BANK_NAME=
FM_PAY_ACCOUNT_NAME=
FM_PAY_ACCOUNT_NO=
FM_PAY_SWIFT=

# 邮件：real 走下面 SMTP；mock 只写日志
FM_EMAIL_MODE=real
FM_SMTP_HOST=127.0.0.1
FM_SMTP_PORT=25
FM_SMTP_USE_SSL=false
FM_SMTP_USE_STARTTLS=false
FM_SMTP_USER=
FM_SMTP_PASSWORD=
FM_SMTP_SENDER=noreply@v2txt.cn
FM_SMTP_SENDER_NAME=V2TXT
FM_EMAIL_MINUTES_AUTO=true

# 语音识别（阿里云百炼）
FM_ASR_PROVIDER=aliyun_filetrans
FM_ASR_MODEL=qwen3-asr-flash
FM_ASR_FILETRANS_MODEL=qwen-audio-3.1-asr-flash-filetrans
FM_ASR_DIARIZATION=true
FM_ASR_PRICE_PER_HOUR=0.8
# key 从 ~/.mm/aliyun 读取（容器挂载为 /app/.mm）

# 大模型
FM_LLM_PROVIDER=aliyun
FM_LLM_MODEL=qwen3.8-flash

# 飞书通道（可选，v2 默认关闭）
FM_FEISHU_MODE=mock
FM_FEISHU_DOC_ENABLED=false

# 上传
FM_UPLOAD_MAX_MB=500
FM_UPLOAD_MAX_MINUTES=300

# 存储
FM_RETENTION_DAYS=30
FM_WORKER_COUNT=2

# 运维
FM_OPS_TOKEN=
FM_ALERT_OPEN_IDS=
FM_MONITORING_ENABLED=true

# 部署参数（给 docker-compose 用）
BIND_ADDR=127.0.0.1
PORT=8080
IMAGE_TAG=latest
APP_UID=1000
APP_GID=1000
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
