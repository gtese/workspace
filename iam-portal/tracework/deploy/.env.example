# 研发工时填报与分摊系统 —— 环境变量模板
# 复制为 deploy/.env 后填写，切勿把真实密码提交到版本库。
#   cp .env.example .env && chmod 600 .env

# ============ 数据库 ============
POSTGRES_DB=timesheet
POSTGRES_USER=timesheet
# 生成方式：openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ============ 会话密钥 ============
# 必须 >= 32 字符。生成方式：openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_CHARS_LONG
SESSION_TTL_MINUTES=480

# ============ AD / LDAP ============
LDAP_URLS=ldap://172.16.10.111,ldap://172.16.10.112
LDAP_BASE_DN=DC=tri,DC=local
LDAP_BIND_DN=sa_ldap@tri.local
LDAP_BIND_PASSWORD=CHANGE_ME_LDAP_SERVICE_PASSWORD
# 用户登录的 UPN 后缀（留空则从 LDAP_BIND_DN 自动推导）
LDAP_UPN_SUFFIX=@tri.local
# 仅允许这些 AD 组内的人员登录（逗号分隔，留空表示不限制）
# 注意：值中含空格时必须用引号包裹，否则 source 时会被拆成命令
LDAP_ALLOWED_GROUPS='Group_AllStaffs'
# 这些组的人在首次同步时被赋予系统管理员角色
LDAP_ADMIN_GROUPS='Group_Roots,Domain Admins'
LDAP_SYNC_INTERVAL_MINUTES=60
LDAP_TLS_VERIFY=true

# ============ 业务参数 ============
APP_BASE_URL=https://work.tri.local
APPROVAL_SLA_WORKDAYS=2
# 0 表示未维护考勤时按「工作日 × 8 小时」折算
DEFAULT_ATTENDANCE_HOURS=0
LOG_LEVEL=info