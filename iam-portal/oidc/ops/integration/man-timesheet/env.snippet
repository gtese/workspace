# ============================================================
# man-timesheet 接入统一身份：.env 变更片段
# 位置：rnd-timesheet/deploy/.env
# ============================================================

# ---------- 新增 ----------
AUTH_MODE=oidc
OIDC_ISSUER=https://sso.tri.local/realms/tri
OIDC_CLIENT_ID=man-timesheet
# 由 IdP 侧提供（在 101 的 ~/projects/oidc-work/deploy/.env 里的 OIDC_CLIENT_SECRET_MAN）
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://man.tri.local/api/auth/oidc/callback
OIDC_POST_LOGOUT_URI=https://man.tri.local/login?logout=1
OIDC_SCOPE=openid profile email roles groups
OIDC_CA_FILE=/etc/ts-certs/tri.local_ca.crt

# ---------- 保留 ----------
# 组准入继续生效：允许登录的 AD 组（从 IdP 的 groups claim 匹配）
LDAP_ALLOWED_GROUPS=Group_AllStaffs
# 角色推导继续生效：管理员由 AD 组推导（首登时用于新用户初始角色）
LDAP_ADMIN_GROUPS=Group_Roots,Domain Admins
# 端口、会话等其他参数不变
SESSION_TTL_MINUTES=480

# ---------- 切换期保留，切换成功后删除 ----------
# LDAP_ENABLED 改为 false 后，服务不再直连域控；保留 1 周用于回滚：
#   AUTH_MODE=ldap && LDAP_ENABLED=true 即可切回旧登录
# LDAP_ENABLED=true
# LDAP_URLS=...
# LDAP_BIND_DN=...
# LDAP_BIND_PASSWORD=...
