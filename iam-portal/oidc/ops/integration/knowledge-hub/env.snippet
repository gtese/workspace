# ============================================================
# 知识平台接入统一身份：deploy/.env 变更（ai.tri.local）
# ============================================================

# ---- 新增 ----
AUTH_MODE=oidc
OIDC_ISSUER=https://sso.tri.local/realms/tri
OIDC_CLIENT_ID=knowledge-hub
# 取法（在 101 上）：grep '^OIDC_CLIENT_SECRET_KB=' deploy/.env | cut -d= -f2-
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://ai.tri.local/api/auth/oidc/callback
OIDC_POST_LOGOUT_URI=https://ai.tri.local/?logout=1
# ★ 必须包含 groups：本系统的角色/部门由 AD 组推导
OIDC_SCOPE=openid profile email roles groups
OIDC_CA_FILE=/etc/kb-certs/tri.local_ca.crt

# ---- 保留（准入与角色推导仍用这两个）----
LDAP_ALLOWED_GROUPS=Group_AllStaffs
LDAP_ADMIN_GROUPS=Group_Roots,Domain Admins
LDAP_REVIEWER_GROUPS=Group_KBReviewers

# ---- 切换期保留（回滚用），验收一周后删除 ----
# LDAP_ENABLED=false          # 接入 OIDC 后关闭直连
# LDAP_URLS=...
# LDAP_BIND_PASSWORD=...
# LDAP_SYNC_INTERVAL_MINUTES=0
