# ===== Trace Voice 容器化配置 =====
# 复制为 .env 并填写；.env 权限 0600，不要提交到仓库。
# 凭据也可以放到 ~/.mm/，容器会以只读方式挂载到 /app/.mm。

# 入口
DOMAIN=voice.example.com
PORT=5266
FM_PUBLIC_BASE_URL=https://voice.example.com:5266
FM_SECRET_KEY=change-me-to-a-long-random-string
IMAGE_TAG=latest

# 数据目录（容器内路径，宿主机卷映射见 compose）
FM_DATA_DIR=/app/data

# 运行参数
FM_WORKER_COUNT=2
FM_RETENTION_DAYS=30
FM_WATCHDOG_SECONDS=300
FM_OPS_TOKEN=
FM_ALERT_OPEN_IDS=

# 转写 / 纪要（aliyun_filetrans 支持说话人分离）
FM_ASR_PROVIDER=aliyun_filetrans
FM_LLM_PROVIDER=aliyun
FM_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FM_ASR_MODEL=qwen3-asr-flash
FM_ASR_FILETRANS_MODEL=qwen-audio-3.1-asr-flash-filetrans
FM_LLM_MODEL=qwen3.8-flash
# 也可用环境变量直接给 Key（否则读 ~/.mm/aliyun）
# FM_ALIYUN_API_KEY=

# 飞书
FM_FEISHU_MODE=real
# FM_FEISHU_APP_ID=
# FM_FEISHU_APP_SECRET=

# 邮件 / 网站回调（可选）
FM_EMAIL_MODE=mock
FM_WEBSITE_CALLBACK_URL=
FM_WEBSITE_CALLBACK_SECRET=

# 数据库：默认 SQLite；用 postgres overlay 时改为下面这行
# FM_DATABASE_URL=postgresql+psycopg://fm:fm@db:5432/fm
